# tests/kat/generated/.gitkeep
#
# Placeholder — keeps the generated/ directory in git.
# The actual content (kat_seeds_128.h, kat_seeds_192.h, kat_seeds_256.h)
# is produced by running:
#
#   python3 tests/kat/gen_kat_seeds.py \
#       --rsp   vendor/hqc-ref/KAT/hqc-<N>/PQCkemKAT_<N>.rsp \
#       --level <128|192|256>                                  \
#       --out   tests/kat/generated/kat_seeds_<N>.h
#
# These generated headers are committed to the repository so that
# CI builds do not need OpenSSL or the NIST rng.c tool.
