# Makefile.hw — Unified on-board build for BPI-F3 (SpacemiT X60)
#
# Standalone Makefile for native compilation on hardware. Does NOT require
# CMake — just GCC on the board.  Consolidates bench and dudect suites.
#
# ═══════════════════════════════════════════════════════════════════════════════
# Usage:
#   make -f Makefile.hw SUITE=bench  LEVEL=128 POLYMUL=scalar_zb
#   make -f Makefile.hw SUITE=dudect TARGET=polymul LEVEL=128 POLYMUL=scalar_zb
#
# Run (pinned to isolated core, max priority):
#   make -f Makefile.hw SUITE=bench  LEVEL=128 POLYMUL=scalar_zb run_kem
#   make -f Makefile.hw SUITE=dudect TARGET=kem LEVEL=128 POLYMUL=scalar_zb run
#
# ═══════════════════════════════════════════════════════════════════════════════
# SUITE (required):
#   bench   — performance benchmarks (kem, mul, keccak, decode)
#   dudect  — constant-time verification via dudect
#
# Common parameters:
#   LEVEL   = 128 | 192 | 256       (security level)
#   POLYMUL = scalar_ref | scalar_zb | vector_rvv | vector_zvk
#   MODE    = dev | publish          (iteration count preset)
#   KECCAK  = ref | zvbb_x2_soa     (keccak implementation for KEM chain)
#   DECODE  = ref | rvv | zvbc       (decode implementation for decode bench)
#
# Bench-specific:
#   EXTENDED = 0 | 1                 (extended PMU counters)
#
# Dudect-specific:
#   TARGET   = polymul | kem         (measurement target)
#   T_THRESH = 4.5                   (t-statistic threshold)
#   SEED     =                       (optional fixed PRNG seed)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Suite selection (default: bench) ─────────────────────────────────────────
SUITE    ?= bench

# ── Common configuration ─────────────────────────────────────────────────────
CC       ?= gcc
LEVEL    ?= 128
POLYMUL  ?= scalar_zb
MODE     ?= dev
OPT      ?= O3

# KECCAK: keccak implementation for KEM chain
#   ref          — vendor scalar fips202 (default)
#   zvbb_x2_soa  — Zvbb×2 SoA vectorized keccak (requires Zvbb)
KECCAK   ?= ref

# DECODE: decode implementation for the decode micro-benchmark
#   ref   — vendor scalar reed_muller + reed_solomon (default)
#   rvv   — RVV vectorized reed_muller + reed_solomon
#   zvbc  — Zvbc vectorized RS + iterative FFT
DECODE   ?= ref

# ── Paths (relative to repository root) ──────────────────────────────────────
VENDOR   := vendor/hqc-ref
SRC      := src
BENCH_DIR := tests/bench
DUDECT_DIR := tests/ct_dudect

# ── Security-level → variant directory mapping ───────────────────────────────
ifeq ($(LEVEL),128)
  VARIANT_DIR := hqc-1
else ifeq ($(LEVEL),192)
  VARIANT_DIR := hqc-3
else ifeq ($(LEVEL),256)
  VARIANT_DIR := hqc-5
else
  $(error Unsupported LEVEL=$(LEVEL). Use 128, 192, or 256)
endif

# ── ISA flags and polymul source per variant ─────────────────────────────────
ifeq ($(POLYMUL),scalar_ref)
  MARCH := rv64gc_zbc_zbb_zbs
  POLYMUL_SRC := $(VENDOR)/src/ref/gf2x.c
  EXTRA_CFLAGS := -fno-tree-vectorize
else ifeq ($(POLYMUL),scalar_zb)
  MARCH := rv64gc_zbc_zbb_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_zbc/gf2x_clmul.c
  EXTRA_CFLAGS := -fno-tree-vectorize
else ifeq ($(POLYMUL),scalar_zb_A)
  MARCH := rv64gc_zbc_zbb_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_zbc/gf2x_clmul_ablation.c
  EXTRA_CFLAGS := -fno-tree-vectorize -DABLATION_WORDLEVEL=1 -DABLATION_NOINIT=0 -DABLATION_AP2=0
else ifeq ($(POLYMUL),scalar_zb_AC)
  MARCH := rv64gc_zbc_zbb_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_zbc/gf2x_clmul_ablation.c
  EXTRA_CFLAGS := -fno-tree-vectorize -DABLATION_WORDLEVEL=1 -DABLATION_NOINIT=0 -DABLATION_AP2=1
else ifeq ($(POLYMUL),scalar_zb_ACB)
  MARCH := rv64gc_zbc_zbb_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_zbc/gf2x_clmul_ablation.c
  EXTRA_CFLAGS := -fno-tree-vectorize -DABLATION_WORDLEVEL=1 -DABLATION_NOINIT=1 -DABLATION_AP2=1
else ifeq ($(POLYMUL),vector_rvv_D)
  # Ablation: direct-write discipline + scalar recomposition + scalar reduce.
  MARCH := rv64gcv_zbc_zbb_zba_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_rvv/gf2x_clmul.c
  EXTRA_CFLAGS := -fno-tree-vectorize \
    -DRVV_ABLATION_HEADER=\"karatsuba_rvv_ablation_dw_scalar_gen.h\" \
    -DRVV_USE_SCALAR_REDUCE=1
else ifeq ($(POLYMUL),vector_rvv_V)
  # Ablation: ref layout + RVV-vectorized recomposition + scalar reduce.
  # Isolates V (vectorized loops) without D (direct-write discipline).
  MARCH := rv64gcv_zbc_zbb_zba_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_rvv/gf2x_clmul.c
  EXTRA_CFLAGS := -fno-tree-vectorize \
    -DRVV_ABLATION_HEADER=\"karatsuba_rvv_ablation_v_only_gen.h\" \
    -DRVV_USE_SCALAR_REDUCE=1
else ifeq ($(POLYMUL),vector_rvv_VD)
  # Ablation: V first, then D on top = same as DV but for alternate ordering story.
  # Direct-write + RVV-vectorized recomposition + scalar reduce.
  MARCH := rv64gcv_zbc_zbb_zba_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_rvv/gf2x_clmul.c
  EXTRA_CFLAGS := -fno-tree-vectorize \
    -DRVV_USE_SCALAR_REDUCE=1
else ifeq ($(POLYMUL),vector_rvv_DV)
  # Ablation: direct-write + RVV-vectorized recomposition + scalar reduce.
  MARCH := rv64gcv_zbc_zbb_zba_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_rvv/gf2x_clmul.c
  EXTRA_CFLAGS := -fno-tree-vectorize \
    -DRVV_USE_SCALAR_REDUCE=1
else ifeq ($(POLYMUL),vector_rvv)
  MARCH := rv64gcv_zbc_zbb_zba_zbs
  POLYMUL_SRC := $(SRC)/mult/karatsuba_rvv/gf2x_clmul.c
  EXTRA_CFLAGS := -fno-tree-vectorize
else ifeq ($(POLYMUL),vector_zvk)
  MARCH := rv64gcv_zbc_zbb_zba_zbs_zvbc_zvbb
  POLYMUL_SRC := $(SRC)/mult/karatsuba_zvbc/gf2x_vclmul.c
  EXTRA_CFLAGS := -DHQC_POLYMUL_ZVBC=1
else
  $(error Unsupported POLYMUL=$(POLYMUL). Use scalar_ref, scalar_zb, scalar_zb_A, scalar_zb_AC, scalar_zb_ACB, vector_rvv_D, vector_rvv_V, vector_rvv_VD, vector_rvv_DV, vector_rvv, or vector_zvk)
endif

# ── Common include paths ─────────────────────────────────────────────────────
INCLUDES := -I$(VENDOR)/src/common/$(VARIANT_DIR) \
            -I$(VENDOR)/src/common \
            -I$(VENDOR)/src/ref/$(VARIANT_DIR) \
            -I$(VENDOR)/src/ref \
            -I$(VENDOR)/lib/fips202 \
            -I$(SRC)/common \
            -Iinclude

# ── Common base CFLAGS ───────────────────────────────────────────────────────
CFLAGS_BASE := -$(OPT) -static -march=$(MARCH) -mabi=lp64d \
               -DSECURITY_LEVEL=$(LEVEL) -DHQC_$(LEVEL) \
               -DHQC_PLATFORM_HW=1 \
               -DHQC_BENCH_MODE=1 \
               -DPOLYMUL_NAME=\"$(POLYMUL)\" \
               $(EXTRA_CFLAGS)

# ── LTO support ──────────────────────────────────────────────────────────────
# LTO provides 1–3% improvement from cross-TU inlining on scalar code.
# However, GCC 14's RISC-V backend ICEs when combining -flto with RVV
# intrinsics (emit_move_insn crash / "target specific builtin not available").
# Therefore: LTO is auto-enabled only for scalar variants (where GCC wins)
# and force-disabled for vector variants.  Override with LTO=0 to disable
# entirely, or LTO=1 to force-enable (may ICE on vector code with GCC).
#
# Clang requires -fuse-ld=lld for LTO (GNU ld lacks LLVMgold.so on this board).

# Detect vector variants (those whose MARCH includes the V extension)
_IS_VECTOR := $(findstring gcv,$(MARCH))

# Default: LTO=1 for scalar, LTO=0 for vector
ifdef LTO
  # User explicitly set LTO — honour it
else
  ifeq ($(_IS_VECTOR),)
    LTO := 1
  else
    LTO := 0
  endif
endif

ifeq ($(LTO),1)
  CFLAGS_BASE += -flto
  ifeq ($(CC),clang)
    CFLAGS_BASE += -fuse-ld=lld
  endif
endif

# ── Core sources (invariant across polymul variants) ─────────────────────────
CORE_SOURCES := $(VENDOR)/src/common/kem.c \
                $(VENDOR)/src/common/crypto_memset.c \
                $(VENDOR)/src/ref/parsing.c \
                $(SRC)/common/gf.c

# ── KEM keccak source selection (controlled by KECCAK variable) ───────────────
ifeq ($(KECCAK),ref)
  KEM_KECCAK_SOURCES := $(VENDOR)/lib/fips202/fips202.c
else ifeq ($(KECCAK),zvbb_x2_soa)
  # GCC cannot compile the Zvbb x2 SoA backend (riscv_rvv_vector_bits is
  # Clang-only, and LMUL=8 KeccakF1600 triggers GCC regalloc issues).
  # Automatically fall back to scalar ref Keccak when CC=gcc.
  ifneq ($(findstring clang,$(CC)),clang)
    $(info NOTE: GCC detected with KECCAK=zvbb_x2_soa — falling back to ref Keccak (Zvbc polymul unaffected))
    KEM_KECCAK_SOURCES := $(VENDOR)/lib/fips202/fips202.c
  else
    KEM_KECCAK_SOURCES := $(SRC)/keccak/fips202_zvbb_x2.c
  endif
else
  $(error Unsupported KECCAK=$(KECCAK). Use ref or zvbb_x2_soa)
endif

# ── KEM decode source selection (controlled by DECODE variable) ───────────────
ifeq ($(DECODE),ref)
  KEM_DECODE_SOURCES := $(VENDOR)/src/ref/reed_muller.c \
                        $(VENDOR)/src/ref/reed_solomon.c \
                        $(VENDOR)/src/common/fft.c
else ifeq ($(DECODE),rvv)
  KEM_DECODE_SOURCES := $(SRC)/decode/reed_muller_rvv.c \
                        $(SRC)/decode/reed_solomon_rvv.c \
                        $(VENDOR)/src/common/fft.c
else ifeq ($(DECODE),zvbc)
  KEM_DECODE_SOURCES := $(SRC)/decode/reed_muller_rvv.c \
                        $(SRC)/decode/reed_solomon_zvbc.c \
                        $(SRC)/decode/fft_zvbc.c
else
  $(error Unsupported DECODE=$(DECODE). Use ref, rvv, or zvbc)
endif

# ── Full KEM source chain (shared by bench_kem and dudect_kem) ───────────────
KEM_CHAIN := $(CORE_SOURCES) \
             $(SRC)/hqc.c \
             $(VENDOR)/src/common/code.c \
             $(VENDOR)/src/common/symmetric.c \
             $(SRC)/vector.c \
             $(SRC)/common/randombytes.c \
             $(POLYMUL_SRC) \
             $(KEM_KECCAK_SOURCES) \
             $(KEM_DECODE_SOURCES)

# ── Output directory for binaries ────────────────────────────────────────────
OUTDIR := build-hw
$(shell mkdir -p $(OUTDIR))


# ══════════════════════════════════════════════════════════════════════════════
# SUITE: bench
# ══════════════════════════════════════════════════════════════════════════════
ifeq ($(SUITE),bench)

# Bench-specific knobs
EXTENDED ?= 1

ifeq ($(MODE),publish)
  N_ITER   ?= 10000
  N_WARMUP ?= 100
else
  N_ITER   ?= 100
  N_WARMUP ?= 10
endif

CFLAGS := $(CFLAGS_BASE) \
          -DN_ITER=$(N_ITER) -DN_WARMUP=$(N_WARMUP)

ifeq ($(EXTENDED),1)
  CFLAGS += -DPERF_HW_EXTENDED=1
endif

# Additional include: bench harness headers
INCLUDES += -I$(BENCH_DIR)

# ── Source lists ─────────────────────────────────────────────────────────────
KEM_SOURCES := $(BENCH_DIR)/bench_kem.c $(KEM_CHAIN)

MUL_SOURCES := $(BENCH_DIR)/bench_mul.c $(POLYMUL_SRC)

KECCAK_SOURCES := $(BENCH_DIR)/bench_keccak.c \
                  $(VENDOR)/src/common/symmetric.c \
                  $(VENDOR)/lib/fips202/fips202.c \
                  $(SRC)/vector.c \
                  $(SRC)/common/randombytes.c

# ── Decode source selection (controlled by DECODE variable) ──────────────────
DECODE_SOURCES := $(BENCH_DIR)/bench_decode.c \
                  $(VENDOR)/src/common/crypto_memset.c \
                  $(SRC)/common/gf.c

ifeq ($(DECODE),rvv)
  DECODE_SOURCES += $(SRC)/decode/reed_muller_rvv.c \
                    $(SRC)/decode/reed_solomon_rvv.c \
                    $(VENDOR)/src/common/fft.c
  DECODE_MARCH := rv64gcv_zbc_zbb_zbs
else ifeq ($(DECODE),zvbc)
  DECODE_SOURCES += $(SRC)/decode/reed_muller_rvv.c \
                    $(SRC)/decode/reed_solomon_zvbc.c \
                    $(SRC)/decode/fft_zvbc.c
  DECODE_MARCH := rv64gcv_zbc_zbb_zbs_zvbc
else
  # ref (default): vendor scalar
  DECODE_SOURCES += $(VENDOR)/src/ref/reed_muller.c \
                    $(VENDOR)/src/ref/reed_solomon.c \
                    $(VENDOR)/src/common/fft.c
  DECODE_MARCH :=
endif

# ── Binary names ─────────────────────────────────────────────────────────────
KEM_BIN    := $(OUTDIR)/bench_hw_kem_hqc$(LEVEL)_$(POLYMUL)
MUL_BIN    := $(OUTDIR)/bench_hw_mul_hqc$(LEVEL)_$(POLYMUL)
KECCAK_BIN := $(OUTDIR)/bench_hw_keccak_hqc$(LEVEL)
DECODE_BIN := $(OUTDIR)/bench_hw_decode_hqc$(LEVEL)_$(DECODE)

# ── Targets ──────────────────────────────────────────────────────────────────
.PHONY: all kem mul keccak decode clean run_kem run_mul run_keccak run_decode \
        info all_variants run_all_mul

all: kem mul keccak decode

kem: $(KEM_BIN)
mul: $(MUL_BIN)
keccak: $(KECCAK_BIN)
decode: $(DECODE_BIN)

$(KEM_BIN): $(KEM_SOURCES) $(BENCH_DIR)/bench_common.h $(BENCH_DIR)/perf_hw.h
	$(CC) $(CFLAGS) $(INCLUDES) $(KEM_SOURCES) -lm -o $@
	@echo "Built: $@ ($(POLYMUL), HQC-$(LEVEL), N_ITER=$(N_ITER))"
	@echo "Verify Zbc/RVV instructions:"
	@objdump -d $@ | grep -cE "clmul|clmulh" || true
	@objdump -d $@ | grep -cE "vle|vse|vxor|vslide" || true

$(MUL_BIN): $(MUL_SOURCES) $(BENCH_DIR)/bench_common.h $(BENCH_DIR)/perf_hw.h
	$(CC) $(CFLAGS) $(INCLUDES) $(MUL_SOURCES) -lm -o $@
	@echo "Built: $@ ($(POLYMUL), HQC-$(LEVEL), N_ITER=$(N_ITER))"

$(KECCAK_BIN): $(KECCAK_SOURCES) $(BENCH_DIR)/bench_common.h $(BENCH_DIR)/perf_hw.h
	$(CC) $(CFLAGS) $(INCLUDES) -DKECCAK_NAME=\"ref\" $(KECCAK_SOURCES) -lm -o $@
	@echo "Built: $@ (HQC-$(LEVEL), N_ITER=$(N_ITER))"

$(DECODE_BIN): $(DECODE_SOURCES) $(BENCH_DIR)/bench_common.h $(BENCH_DIR)/perf_hw.h
ifneq ($(DECODE_MARCH),)
	$(CC) -$(OPT) -static -march=$(DECODE_MARCH) -mabi=lp64d \
	    -DSECURITY_LEVEL=$(LEVEL) -DHQC_$(LEVEL) \
	    -DHQC_PLATFORM_HW=1 -DHQC_BENCH_MODE=1 \
	    -DN_ITER=$(N_ITER) -DN_WARMUP=$(N_WARMUP) \
	    $(INCLUDES) -DDECODE_NAME=\"$(DECODE)\" $(DECODE_SOURCES) -lm -o $@
else
	$(CC) $(CFLAGS) $(INCLUDES) -DDECODE_NAME=\"$(DECODE)\" $(DECODE_SOURCES) -lm -o $@
endif
	@echo "Built: $@ (DECODE=$(DECODE), HQC-$(LEVEL), N_ITER=$(N_ITER))"

run_kem: $(KEM_BIN)
	sudo nice -n -20 taskset -c 7 ./$(KEM_BIN)

run_mul: $(MUL_BIN)
	sudo nice -n -20 taskset -c 7 ./$(MUL_BIN)

run_keccak: $(KECCAK_BIN)
	sudo nice -n -20 taskset -c 7 ./$(KECCAK_BIN)

run_decode: $(DECODE_BIN)
	sudo nice -n -20 taskset -c 7 ./$(DECODE_BIN)

all_variants:
	$(MAKE) -f Makefile.hw SUITE=bench LEVEL=$(LEVEL) POLYMUL=scalar_ref
	$(MAKE) -f Makefile.hw SUITE=bench LEVEL=$(LEVEL) POLYMUL=scalar_zb
	$(MAKE) -f Makefile.hw SUITE=bench LEVEL=$(LEVEL) POLYMUL=vector_rvv

run_all_mul:
	@echo "=== scalar_ref ==="
	$(MAKE) -f Makefile.hw SUITE=bench LEVEL=$(LEVEL) POLYMUL=scalar_ref run_mul
	@echo ""
	@echo "=== scalar_zb ==="
	$(MAKE) -f Makefile.hw SUITE=bench LEVEL=$(LEVEL) POLYMUL=scalar_zb run_mul
	@echo ""
	@echo "=== vector_rvv ==="
	$(MAKE) -f Makefile.hw SUITE=bench LEVEL=$(LEVEL) POLYMUL=vector_rvv run_mul

info:
	@echo "Suite: bench"
	@echo "  CC       = $(CC)"
	@echo "  LEVEL    = $(LEVEL)"
	@echo "  POLYMUL  = $(POLYMUL)"
	@echo "  MODE     = $(MODE)"
	@echo "  LTO      = $(LTO)"
	@echo "  MARCH    = $(MARCH)"
	@echo "  N_ITER   = $(N_ITER)"
	@echo "  N_WARMUP = $(N_WARMUP)"
	@echo "  EXTENDED = $(EXTENDED)"
	@echo "  KEM_BIN  = $(KEM_BIN)"
	@echo "  MUL_BIN  = $(MUL_BIN)"

# ── PGO targets (two-pass: generate profile → train → rebuild with profile) ─
# Usage:
#   make -f Makefile.hw SUITE=bench LEVEL=128 POLYMUL=scalar_zb pgo_kem
#   make -f Makefile.hw SUITE=bench LEVEL=128 POLYMUL=scalar_zb pgo_mul
#
# The resulting binary is the same KEM_BIN/MUL_BIN but compiled with PGO data.
# PGO provides 5–12% improvement by training branch predictors and code layout.

PGO_DIR       := $(OUTDIR)/pgo_data/$(POLYMUL)_hqc$(LEVEL)
PGO_TRAIN_ITER ?= 50

# CFLAGS for training pass (fewer iterations to keep training fast)
PGO_TRAIN_CFLAGS := $(CFLAGS_BASE) -DN_ITER=$(PGO_TRAIN_ITER) -DN_WARMUP=5
ifeq ($(EXTENDED),1)
  PGO_TRAIN_CFLAGS += -DPERF_HW_EXTENDED=1
endif

.PHONY: pgo_kem pgo_mul pgo_clean

pgo_kem:
	@mkdir -p $(PGO_DIR)
	@echo "━━━ PGO [1/3] Building instrumented binary ━━━"
	$(CC) $(PGO_TRAIN_CFLAGS) -fprofile-generate=$(PGO_DIR) \
	    $(INCLUDES) $(KEM_SOURCES) -lm -lgcov -o $(KEM_BIN)
	@echo "━━━ PGO [2/3] Training ($(PGO_TRAIN_ITER) iterations) ━━━"
	sudo nice -n -20 taskset -c 7 ./$(KEM_BIN) > /dev/null 2>&1
	@echo "  Profile files: $$(find $(PGO_DIR) -name '*.gcda' | wc -l) .gcda"
	@echo "━━━ PGO [3/3] Rebuilding with profile data ━━━"
	$(CC) $(CFLAGS) -fprofile-use=$(PGO_DIR) -fprofile-correction \
	    $(INCLUDES) $(KEM_SOURCES) -lm -o $(KEM_BIN)
	@echo "✓ PGO build complete: $(KEM_BIN)"
	@size $(KEM_BIN) | awk 'NR==2{printf "  .text: %s bytes\n", $$1}'

pgo_mul:
	@mkdir -p $(PGO_DIR)
	@echo "━━━ PGO [1/3] Building instrumented binary ━━━"
	$(CC) $(PGO_TRAIN_CFLAGS) -fprofile-generate=$(PGO_DIR) \
	    $(INCLUDES) $(MUL_SOURCES) -lm -lgcov -o $(MUL_BIN)
	@echo "━━━ PGO [2/3] Training ($(PGO_TRAIN_ITER) iterations) ━━━"
	sudo nice -n -20 taskset -c 7 ./$(MUL_BIN) > /dev/null 2>&1
	@echo "  Profile files: $$(find $(PGO_DIR) -name '*.gcda' | wc -l) .gcda"
	@echo "━━━ PGO [3/3] Rebuilding with profile data ━━━"
	$(CC) $(CFLAGS) -fprofile-use=$(PGO_DIR) -fprofile-correction \
	    $(INCLUDES) $(MUL_SOURCES) -lm -o $(MUL_BIN)
	@echo "✓ PGO build complete: $(MUL_BIN)"
	@size $(MUL_BIN) | awk 'NR==2{printf "  .text: %s bytes\n", $$1}'

pgo_clean:
	rm -rf $(OUTDIR)/pgo_data

# ── Profile targets (harness-free, for perf record task-clock profiling) ──────
# These binaries contain NO perf_event_open harness — just a tight loop calling
# the target function.  Compiled at -O3 -fno-omit-frame-pointer -g for frame-
# pointer call graphs with full inlining (no -fno-inline, no -pg).
#
# Usage:
#   make -f Makefile.hw SUITE=bench LEVEL=128 POLYMUL=scalar_zb profile_mul
#   perf record -e task-clock -F 4999 --call-graph fp -- taskset -c 7 ./build-hw/bench_profile_mul_hqc128_scalar_zb

PROFILE_CFLAGS := -O3 -fno-omit-frame-pointer -g -static -march=$(MARCH) -mabi=lp64d \
                  -DSECURITY_LEVEL=$(LEVEL) -DHQC_$(LEVEL) \
                  -DHQC_PLATFORM_HW=1 -DHQC_BENCH_MODE=1 \
                  -DPOLYMUL_NAME=\"$(POLYMUL)\" \
                  $(EXTRA_CFLAGS)

ifeq ($(LTO),1)
  PROFILE_CFLAGS += -flto
  ifeq ($(CC),clang)
    PROFILE_CFLAGS += -fuse-ld=lld
  endif
endif

# N_PROFILE: target ~2-5s at 1.6 GHz for >5000 samples at 4999 Hz
# mul is fast (~160K cycles) → need many iterations
# kem is slow (~millions of cycles) → fewer iterations suffice
N_PROFILE_MUL ?= 50000
N_PROFILE_KEM ?= 2000

PROFILE_MUL_BIN    := $(OUTDIR)/bench_profile_mul_hqc$(LEVEL)_$(POLYMUL)
PROFILE_KEM_BIN    := $(OUTDIR)/bench_profile_kem_hqc$(LEVEL)_$(POLYMUL)

PROFILE_MUL_SOURCES := $(BENCH_DIR)/bench_profile_mul.c $(POLYMUL_SRC)
PROFILE_KEM_SOURCES := $(BENCH_DIR)/bench_profile_kem.c $(KEM_CHAIN)

.PHONY: profile_mul profile_kem

profile_mul: $(PROFILE_MUL_BIN)
profile_kem: $(PROFILE_KEM_BIN)

$(PROFILE_MUL_BIN): $(PROFILE_MUL_SOURCES)
	$(CC) $(PROFILE_CFLAGS) -DN_PROFILE=$(N_PROFILE_MUL) \
	    $(INCLUDES) $(PROFILE_MUL_SOURCES) -lm -o $@
	@echo "Built (profile): $@ ($(POLYMUL), HQC-$(LEVEL), N_PROFILE=$(N_PROFILE_MUL))"

$(PROFILE_KEM_BIN): $(PROFILE_KEM_SOURCES)
	$(CC) $(PROFILE_CFLAGS) -DN_PROFILE=$(N_PROFILE_KEM) \
	    $(INCLUDES) -I$(VENDOR)/lib/fips202 $(PROFILE_KEM_SOURCES) -lm -o $@
	@echo "Built (profile): $@ ($(POLYMUL), HQC-$(LEVEL), N_PROFILE=$(N_PROFILE_KEM))"

# ── Roofline peak micro-benchmark ───────────────────────────────────────────
ROOFLINE_BIN := $(OUTDIR)/roofline_peak
ROOFLINE_SRC := $(BENCH_DIR)/roofline_peak.c

.PHONY: roofline

roofline: $(ROOFLINE_BIN)

$(ROOFLINE_BIN): $(ROOFLINE_SRC)
	$(CC) -O3 -static -march=rv64gcv_zbc_zbb_zbs -mabi=lp64d $(ROOFLINE_SRC) -lm -o $@
	@echo "Built (roofline): $@"

run_roofline: $(ROOFLINE_BIN)
	sudo nice -n -20 taskset -c 7 ./$(ROOFLINE_BIN)

clean:
	rm -f $(OUTDIR)/bench_hw_* $(OUTDIR)/bench_profile_* $(OUTDIR)/roofline_peak


# ══════════════════════════════════════════════════════════════════════════════
# SUITE: dudect
# ══════════════════════════════════════════════════════════════════════════════
else ifeq ($(SUITE),dudect)

# Dudect-specific knobs
TARGET   ?= polymul
T_THRESH ?= 4.5
SEED     ?=

ifeq ($(MODE),publish)
  N_MAX      ?= 10000000
  BATCH_SIZE ?= 10000
else
  N_MAX      ?= 100000
  BATCH_SIZE ?= 5000
endif

CFLAGS := $(CFLAGS_BASE) \
          -DN_MAX=$(N_MAX) -DBATCH_SIZE=$(BATCH_SIZE) \
          -DT_THRESHOLD=$(T_THRESH)

ifneq ($(SEED),)
  CFLAGS += -DDUDECT_FIXED_SEED=$(SEED)
endif

# Additional includes: bench headers (for perf_hw.h) and dudect dir
INCLUDES += -I$(BENCH_DIR) -I$(DUDECT_DIR)

# ── Source lists ─────────────────────────────────────────────────────────────
DUDECT_POLYMUL_SOURCES := $(DUDECT_DIR)/dudect_polymul.c $(POLYMUL_SRC)

DUDECT_KEM_SOURCES := $(DUDECT_DIR)/dudect_kem.c $(KEM_CHAIN)

# ── Select sources based on TARGET ───────────────────────────────────────────
ifeq ($(TARGET),polymul)
  SOURCES := $(DUDECT_POLYMUL_SOURCES)
else ifeq ($(TARGET),kem)
  SOURCES := $(DUDECT_KEM_SOURCES)
else
  $(error Unsupported TARGET=$(TARGET). Use polymul or kem)
endif

# ── Binary name ──────────────────────────────────────────────────────────────
BIN := $(OUTDIR)/dudect_$(TARGET)_hqc$(LEVEL)_$(POLYMUL)

# ── Targets ──────────────────────────────────────────────────────────────────
.PHONY: all build clean run info all_variants

all: build

build: $(BIN)

$(BIN): $(SOURCES)
	$(CC) $(CFLAGS) $(INCLUDES) $(SOURCES) -lm -o $@
	@echo "Built: $@ ($(TARGET), $(POLYMUL), HQC-$(LEVEL), MODE=$(MODE))"
	@echo "  N_MAX=$(N_MAX) BATCH_SIZE=$(BATCH_SIZE) T_THRESHOLD=$(T_THRESH)"

run: $(BIN)
	sudo nice -n -20 taskset -c 7 ./$(BIN)

all_variants:
	$(MAKE) -f Makefile.hw SUITE=dudect TARGET=$(TARGET) LEVEL=$(LEVEL) POLYMUL=scalar_ref MODE=$(MODE)
	$(MAKE) -f Makefile.hw SUITE=dudect TARGET=$(TARGET) LEVEL=$(LEVEL) POLYMUL=scalar_zb MODE=$(MODE)
	$(MAKE) -f Makefile.hw SUITE=dudect TARGET=$(TARGET) LEVEL=$(LEVEL) POLYMUL=vector_rvv MODE=$(MODE)

info:
	@echo "Suite: dudect"
	@echo "  CC         = $(CC)"
	@echo "  TARGET     = $(TARGET)"
	@echo "  LEVEL      = $(LEVEL)"
	@echo "  POLYMUL    = $(POLYMUL)"
	@echo "  MODE       = $(MODE)"
	@echo "  MARCH      = $(MARCH)"
	@echo "  N_MAX      = $(N_MAX)"
	@echo "  BATCH_SIZE = $(BATCH_SIZE)"
	@echo "  T_THRESH   = $(T_THRESH)"
	@echo "  SEED       = $(SEED)"
	@echo "  BIN        = $(BIN)"

clean:
	rm -f $(OUTDIR)/dudect_*


# ══════════════════════════════════════════════════════════════════════════════
# Invalid SUITE
# ══════════════════════════════════════════════════════════════════════════════
else
  $(error Unsupported SUITE=$(SUITE). Use bench or dudect)
endif
