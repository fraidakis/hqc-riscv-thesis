#!/usr/bin/env bash
# toolchain.env — source this file to configure the HQC-RISC-V toolchain environment
# Usage: source toolchain/toolchain.env
# 
# This script searches for a pre-built RISC-V toolchain in standard locations,
# supporting both local development and GitHub Actions CI environments.

if [ -z "${RISCV:-}" ]; then
	_this_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
	_repo_parent="$(cd "$_this_dir/../.." && pwd)"
	
	# Search candidates prioritized for CI robustness and local development compatibility
	for _cand in \
		"${GITHUB_WORKSPACE:-}/riscv-tools" \
		"${GITHUB_WORKSPACE:-}/../riscv-tools" \
		"$HOME/riscv-tools" \
		"$HOME/Thesis/toolchains/installed-tools" \
		"$HOME/Thesis/installed-tools" \
		"$_repo_parent/riscv-tools" \
		"$_repo_parent/toolchains/installed-tools" \
		"${GITHUB_WORKSPACE:-}/toolchains/installed-tools"
	do
		if [ -n "$_cand" ] && [ -x "$_cand/bin/clang" ]; then
			RISCV="$_cand"
			break
		fi
	done
	unset _cand _this_dir _repo_parent
fi

export RISCV="${RISCV:-$HOME/riscv-tools}"
export PATH="$RISCV/bin:$PATH"
export SYSROOT="$RISCV/riscv64-unknown-elf"

export CC="$RISCV/bin/riscv64-unknown-elf-clang"
export CXX="$RISCV/bin/riscv64-unknown-elf-clang++"
export GCC="$RISCV/bin/riscv64-unknown-elf-gcc"
export CLANG="$RISCV/bin/clang"
export CLANGXX="$RISCV/bin/clang++"
export OBJDUMP="$RISCV/bin/riscv64-unknown-elf-objdump"
export SPIKE="$RISCV/bin/spike"
export QEMU="$RISCV/bin/qemu-system-riscv64"

echo "[toolchain.env] RISCV=$RISCV"
echo "[toolchain.env] PATH updated with $RISCV/bin"
